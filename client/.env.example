VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-public-key
# Leave empty for same-domain deploys. Use http://localhost:4000 when running the client separately.
VITE_API_URL=

# Chỉ dùng cho bản demo chạy không có server/Supabase: client tự dựng QR SePay.
# Khi có server, QR do /api/payments/checkout trả về nên bỏ trống cũng được.
VITE_SEPAY_ACCOUNT_NUMBER=
VITE_SEPAY_BANK_CODE=
VITE_SEPAY_ACCOUNT_NAME=
VITE_SEPAY_CODE_PREFIX=NN3K
