# Server Environment Variables
# Copy this file to .env and fill in your values.

# Server port
PORT=4000

# Node environment
NODE_ENV=development

# Supabase (required for real DB & auth)
# Get these from: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key

# Google OAuth (configured via Supabase Auth dashboard, not needed here directly)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Thanh toán tự động qua SePay (https://my.sepay.vn)
# Chạy supabase/sepay-payment-migration.sql trước khi bật.
#
# Tài khoản ngân hàng đã liên kết trong SePay — dùng để dựng QR động.
SEPAY_ACCOUNT_NUMBER=
# Mã/short name ngân hàng theo https://vietqr.app/banks.json, vd MBBank, ACB, TPBank.
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
# API key tự đặt ở SePay → Công ty → Webhooks (kiểu xác thực API Key).
# Webhook URL khai với SePay: https://<domain>/api/payments/sepay/webhook
SEPAY_WEBHOOK_API_KEY=
# Tiền tố mã chuyển khoản (mặc định NN3K → nội dung dạng NN3K8F2K1P).
SEPAY_CODE_PREFIX=NN3K
# Kiểu ảnh QR: compact (mặc định), qronly, standee.
SEPAY_QR_TEMPLATE=compact

# Consultation form (homepage hero) → Google Sheets
# See README.md "Consultation form (Google Sheets)" for how to create this
# Apps Script Web App URL. Leave empty to log leads to the console instead
# of sending them anywhere (mock mode).
GOOGLE_SHEETS_WEBHOOK_URL=
